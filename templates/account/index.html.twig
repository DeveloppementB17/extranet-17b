{% extends 'base.html.twig' %}
{% import '_icon_macros.html.twig' as icons %}

{% block title %}Mon compte{% endblock %}

{% block body %}
    <nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">Mon compte</span>
    </nav>

    <div class="panel mx-auto max-w-lg px-8 py-8">
        <h1 class="text-5xl font-extrabold text-brand">Mon compte</h1>
        <p class="mt-2 text-sm text-slate-600">Informations liées à votre session sur l’extranet.</p>

        {% for message in app.flashes('success') %}
            <div class="mt-6 rounded border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mt-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        <dl class="mt-8 space-y-6 text-sm">
            <div>
                <dt class="font-semibold text-slate-600">Email</dt>
                <dd class="mt-1 text-slate-900">{{ user.email }}</dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Entreprise</dt>
                <dd class="mt-1 text-slate-900">
                    {{ user.entreprise.name }}
                    <span class="text-slate-500">({{ user.entreprise.slug }})</span>
                </dd>
            </div>
            <div>
                <dt class="font-semibold text-slate-600">Rôles</dt>
                <dd class="mt-2">
                    <ul class="list-inside list-disc space-y-1 text-slate-900">
                        {% for role in display_roles %}
                            <li><span class="font-mono text-xs text-slate-500">{{ role }}</span> — {{ role|role_label }}</li>
                        {% endfor %}
                    </ul>
                    <p class="mt-3 text-xs text-slate-500">Les libellés correspondent aux droits dans l’application.</p>
                </dd>
            </div>
        </dl>

        <section class="mt-10 border-t border-slate-200 pt-8" aria-labelledby="account-password-heading">
            <h2 id="account-password-heading" class="text-xl font-bold text-brand">Mot de passe</h2>
            <p class="mt-2 text-sm text-slate-600">
                Modifiez votre mot de passe de connexion (formulaire email / mot de passe).
            </p>

            {{ form_start(password_form, { attr: { class: 'mt-6 space-y-5' } }) }}
                {{ form_row(password_form.currentPassword) }}
                {{ form_row(password_form.plainPassword.first) }}
                {{ form_row(password_form.plainPassword.second) }}
                {{ form_errors(password_form.plainPassword) }}

                <div class="pt-2">
                    <button type="submit" class="inline-flex cursor-pointer items-center gap-2 bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover">
                        {{ icons.icon('check') }}
                        Enregistrer le nouveau mot de passe
                    </button>
                </div>
            {{ form_end(password_form) }}

            <p class="mt-4 text-xs text-slate-500">
                Mot de passe oublié ?
                <a class="font-medium text-brand underline" href="{{ path('auth_forgot_password') }}">Réinitialiser par email</a>
            </p>
        </section>

        <p class="mt-8 text-sm">
            <a class="font-medium text-brand underline" href="{{ path('app_home') }}">← Retour à l’accueil</a>
        </p>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% set is_edit_mode = is_edit_mode|default(false) %}
{% set available_minutes = available_minutes|default(credit.remainingMinutes) %}
{% set page_title = is_edit_mode ? 'Modifier l\'intervention' : 'Déclarer une intervention' %}
{% set submit_label = is_edit_mode ? 'Enregistrer les modifications' : 'Enregistrer l\'intervention' %}

{% block title %}{{ page_title }}{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <a href="{{ path('time_credit_index') }}" class="hover:underline">Crédits temps</a>
        <span class="text-neutral-400"> / </span>
        <a href="{{ path('time_credit_show', { id: credit.id }) }}" class="hover:underline">{{ credit.title }}</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">{{ page_title }}</span>
    </nav>

    <p class="mt-6 text-m">
            <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ cancel_url }}">← Retour</a>
        </p>

    
    <div class="panel border-2 border-black mx-auto max-w-xl px-8 py-8">
        <h1 class="text-3xl font-extrabold text-brand">{{ page_title }}</h1>
        <p class="mt-2 text-sm text-slate-600">
            {% set remaining_display_in_hours = available_minutes > 180 %}
            Crédit : <span class="font-medium">{{ credit.title }}</span> — disponible :
            <span
                class="cursor-help"
                data-tooltip-target="tc-intervention-remaining-tooltip"
                data-tooltip-placement="top"
                tabindex="0"
            >
                {{ remaining_display_in_hours ? (available_minutes / 60)|round(2) ~ ' h' : available_minutes ~ ' min' }}
            </span>.
            <div id="tc-intervention-remaining-tooltip" role="tooltip" class="tooltip absolute z-10 invisible inline-block rounded-base border border-default bg-neutral-primary-soft px-3 py-2 text-xs text-body opacity-0 shadow-xs">
                {{ remaining_display_in_hours ? available_minutes ~ ' min' : (available_minutes / 60)|round(2) ~ ' h' }}
                <div class="tooltip-arrow" data-popper-arrow></div>
            </div>
            {% if is_edit_mode %}
                <span class="block mt-1 text-xs text-slate-500">Le solde inclut la durée actuelle de cette intervention.</span>
            {% endif %}
        </p>

        {% for message in app.flashes('error') %}
            <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, { attr: { class: 'mt-8 space-y-8' } }) }}
            {% include 'time_credit/_intervention_form_fields.html.twig' %}
            {% if form.returnTo is defined %}
                {{ form_widget(form.returnTo) }}
            {% endif %}

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="ml-auto block bg-brand-primary px-6 py-2 text-xl font-bold text-white hover:bg-brand-primary-hover button">{{ submit_label }}</button>
                <a class="border border-slate-200 px-6 py-2 text-xl font-bold text-slate-700 hover:bg-slate-50" href="{{ cancel_url }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
    {% include 'time_credit/_intervention_duration_unit_script.html.twig' %}
{% endblock %}

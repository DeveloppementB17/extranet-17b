{% set wrapper_class = embedded|default(false) ? 'panel-muted border-2 border-black rounded-sm p-5' : 'panel border-2 border-black mx-auto max-w-xl px-8 py-8' %}
{% set title_tag = embedded|default(false) ? 'h2' : 'h1' %}
{% set title_class = embedded|default(false) ? 'text-lg font-extrabold text-brand' : 'text-3xl font-extrabold text-brand' %}

<div class="{{ wrapper_class }}">
    <{{ title_tag }} class="{{ title_class }}">Déclarer une intervention</{{ title_tag }}>

    {% if selected_entreprise is not null %}
        <p class="mt-2 text-sm text-slate-600">
            Entreprise active : <span class="font-medium">{{ selected_entreprise.name }}</span>
        </p>
        {% if has_available_credits %}
            {% if fixed_credit is defined and fixed_credit %}
                <p class="mt-2 text-sm text-slate-600">
                    {% set remaining_display_in_hours = fixed_credit.remainingMinutes > 180 %}
                    Crédit : <span class="font-medium">{{ fixed_credit.title }}</span> — disponible :
                    {{ remaining_display_in_hours ? (fixed_credit.remainingMinutes / 60)|round(2) ~ ' h' : fixed_credit.remainingMinutes ~ ' min' }}.
                </p>
            {% endif %}
            {{ form_start(form, { attr: { class: (embedded|default(false) ? 'mt-4' : 'mt-8') ~ ' space-y-8' } }) }}
                {% if form.timeCredit is defined and form.timeCredit.vars.attr.class|default('') != 'hidden' %}
                    <div>
                        {{ form_label(form.timeCredit, null, { label_attr: { class: 'block text-lg font-semibold text-brand mb-2' } }) }}
                        {{ form_widget(form.timeCredit, { attr: { class: 'block py-2.5 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium focus:outline-none focus:ring-0', 'data-intervention-credit-select': '1' } }) }}
                        {{ form_errors(form.timeCredit) }}
                    </div>
                {% elseif form.timeCreditId is defined %}
                    {{ form_widget(form.timeCreditId) }}
                {% endif %}
                {% include 'time_credit/_intervention_form_fields.html.twig' with {
                    max_duration_minutes: fixed_credit is defined and fixed_credit ? fixed_credit.remainingMinutes : 0
                } %}
                {% if form.returnTo is defined %}
                    {{ form_widget(form.returnTo) }}
                {% endif %}

                <div class="flex flex-wrap gap-3">
                    <button type="submit" class="ml-auto block bg-brand-primary px-6 py-2 text-xl font-bold text-white hover:bg-brand-primary-hover button">
                        Enregistrer l'intervention
                    </button>
                    {% if cancel_url is defined and not embedded|default(false) %}
                        <a class="border border-slate-200 px-6 py-2 text-xl font-bold text-slate-700 hover:bg-slate-50" href="{{ cancel_url }}">Annuler</a>
                    {% endif %}
                </div>
            {{ form_end(form) }}
            {% include 'time_credit/_intervention_duration_unit_script.html.twig' %}
        {% else %}
            <p class="mt-3 text-sm text-slate-700">Aucun crédit actif avec minutes disponibles pour cette entreprise.</p>
        {% endif %}
    {% else %}
        <p class="mt-2 text-sm text-slate-700">Sélectionnez d'abord une entreprise pour déclarer une intervention.</p>
    {% endif %}
</div>

{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <a href="{{ path('time_credit_index') }}" class="hover:underline">Crédits temps</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">{{ title }}</span>
    </nav>
    <div class="mx-auto">
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 align-middle">
        <div class="flex flex-col gap-4">
        <p class="mt-6 text-m">
                <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('time_credit_index') }}">← Retour à la liste</a>
            </p>
        <h1 class="text-5xl font-extrabold text-brand">{{ title }}</h1>
        <p class="mt-2 text-m text-slate-600">
            {% if edit_mode|default(false) %}
                Le titre et le total initial restent historiques. L'archivage permet de fermer le crédit.
            {% else %}
                Le titre est généré automatiquement à la création (date/heure).
            {% endif %}
        </p>
    </div>

    <div class="panel border-2 border-black px-8 py-8">
        

        {% for message in app.flashes('error') %}
            <div class="mt-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, { attr: { class: 'mt-8 space-y-8' } }) }}
            <div>
                {{ form_label(form.entreprise, null, { label_attr: { class: 'block text-lg font-semibold text-brand mb-2' } }) }}
                {{ form_widget(form.entreprise, { attr: { class: 'block py-2.5 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium focus:outline-none focus:ring-0' } }) }}
                {{ form_errors(form.entreprise) }}
            </div>
            <div>
                {{ form_label(form.category, null, { label_attr: { class: 'block text-lg font-semibold text-brand mb-2' } }) }}
                {{ form_widget(form.category, { attr: { class: 'block py-2.5 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium focus:outline-none focus:ring-0' } }) }}
                {{ form_errors(form.category) }}
            </div>
            <div class="relative z-0 w-full group">
                {{ form_widget(form.dossierNumber, { attr: { class: 'block pt-2.5 pb-1 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium appearance-none focus:outline-none focus:ring-0 peer', placeholder: ' ' } }) }}
                {{ form_label(form.dossierNumber, null, { label_attr: { class: 'absolute text-lg font-semibold text-brand duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 peer-focus:bg-black peer-focus:text-white peer-focus:px-2 peer-focus:text-fg-brand peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto' } }) }}
                {{ form_errors(form.dossierNumber) }}
            </div>
            <div class="relative z-0 w-full group">
                {{ form_widget(form.totalMinutes, { attr: { class: 'block pt-2.5 pb-1 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium appearance-none focus:outline-none focus:ring-0 peer', placeholder: ' ' } }) }}
                {{ form_label(form.totalMinutes, null, { label_attr: { class: 'absolute text-lg font-semibold text-brand duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 peer-focus:bg-black peer-focus:text-white peer-focus:px-2 peer-focus:text-fg-brand peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto' } }) }}
                {{ form_errors(form.totalMinutes) }}
            </div>
            {% if form.archived is defined %}
                <div class="rounded bg-slate-50 px-3 py-3 ring-1 ring-slate-200">
                    {{ form_row(form.archived) }}
                </div>
            {% endif %}

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="ml-auto block bg-brand-primary px-6 py-2 text-xl font-bold text-white hover:bg-brand-primary-hover button">Enregistrer</button>
                <a class="border border-slate-200 px-6 py-2 text-xl font-bold text-slate-700 hover:bg-slate-50" href="{{ path('time_credit_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
    </div>
    </div>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ credit.title }}{% endblock %}

{% block body %}
    {% set consumed_minutes = credit.totalMinutes - credit.remainingMinutes %}
    {% if consumed_minutes < 0 %}
        {% set consumed_minutes = 0 %}
    {% endif %}

    {% for message in app.flashes('success') %}
        <div class="mb-6 border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-6 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
    {% endfor %}

    <nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <a href="{{ path('time_credit_index') }}" class="hover:underline">Crédits temps</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">{{ credit.title }}</span>
    </nav>
    
    <p class="mt-6 text-m">
                    <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('time_credit_index') }}">← Retour à la liste des crédits</a>
                </p>

    <div class="panel py-8">
        <div class="grid grid-cols-1 2xl:grid-cols-2 gap-4">
            <div>
                <h1 class="mt-6 text-5xl font-extrabold text-brand">{{ credit.title }}</h1>
                <p class="mt-1 text-sm text-slate-600">
                    {{ credit.entreprise.name }}
                    {% if credit.dossierNumber %}
                        — Dossier {{ credit.dossierNumber }}
                    {% endif %}
                </p>
            </div>
            

            <div class="mt-6 w-full grid gap-4 grid-cols-2 md:grid-cols-4">
            <div class="col-span-1 p-4 ring-1 ring-black">
                <div class="text-xs uppercase tracking-wide text-slate-500">Total</div>
                <div class="mt-1 text-lg font-semibold text-slate-900">
                    {% set total_display_in_hours = credit.totalMinutes > 180 %}
                    <span
                        class="cursor-help"
                        data-tooltip-target="tc-show-total-tooltip"
                        data-tooltip-placement="top"
                        tabindex="0"
                    >
                        {{ total_display_in_hours ? (credit.totalMinutes / 60)|round(2) ~ ' h' : credit.totalMinutes ~ ' min' }}
                    </span>
                    <div id="tc-show-total-tooltip" role="tooltip" class="tooltip absolute z-10 invisible inline-block rounded-base border border-default bg-neutral-primary-soft px-3 py-2 text-xs text-body opacity-0 shadow-xs">
                        {{ total_display_in_hours ? credit.totalMinutes ~ ' min' : (credit.totalMinutes / 60)|round(2) ~ ' h' }}
                        <div class="tooltip-arrow" data-popper-arrow></div>
                    </div>
                </div>
            </div>
            <div class="col-span-1 p-4 ring-1 ring-black">
                <div class="text-xs uppercase tracking-wide text-slate-500">Disponible</div>
                <div class="mt-1 text-lg font-semibold {{ credit.remainingMinutes <= 0 ? 'text-red-700' : 'text-slate-900' }}">
                    {% set remaining_display_in_hours = credit.remainingMinutes > 180 %}
                    <span
                        class="cursor-help"
                        data-tooltip-target="tc-show-remaining-tooltip"
                        data-tooltip-placement="top"
                        tabindex="0"
                    >
                        {{ remaining_display_in_hours ? (credit.remainingMinutes / 60)|round(2) ~ ' h' : credit.remainingMinutes ~ ' min' }}
                    </span>
                    <div id="tc-show-remaining-tooltip" role="tooltip" class="tooltip absolute z-10 invisible inline-block rounded-base border border-default bg-neutral-primary-soft px-3 py-2 text-xs text-body opacity-0 shadow-xs">
                        {{ remaining_display_in_hours ? credit.remainingMinutes ~ ' min' : (credit.remainingMinutes / 60)|round(2) ~ ' h' }}
                        <div class="tooltip-arrow" data-popper-arrow></div>
                    </div>
                </div>
            </div>
            <div class="col-span-1 p-4 ring-1 ring-black">
                <div class="text-xs uppercase tracking-wide text-slate-500">Catégorie</div>
                <div class="mt-1 text-sm font-semibold text-slate-900">{{ credit.category ? credit.category.name : '—' }}</div>
            </div>
            <div class="col-span-1 p-4 ring-1 ring-black">
                <div class="text-xs uppercase tracking-wide text-slate-500">Statut</div>
                <div class="mt-1 text-sm text-center font-semibold {{ credit.archived ? 'text-red-700 bg-red-100 px-2 py-1 rounded-md' : 'text-green-700 bg-green-100 px-2 py-1 rounded-md' }}">{{ credit.archived ? 'Archivé' : 'Actif' }}</div>
            </div>
        </div>
        </div>

        

        <div class=" mt-6">

        <div class="flex flex-wrap gap-2">
                {% if is_granted('TIME_CREDIT_MANAGE', credit) %}
                    <a class="border border-slate-200 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" href="{{ path('time_credit_edit', { id: credit.id }) }}">Modifier</a>
                {% endif %}
                {% if is_granted('ROLE_17B_ADMIN') %}
                    <form method="post" action="{{ path('time_credit_delete', { id: credit.id }) }}" onsubmit="return confirm({{ intervention_count > 0 ? "'Supprimer ce crédit temps et toutes ses interventions ?'" : "'Supprimer ce crédit temps ?'" }});">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete_time_credit' ~ credit.id) }}">
                        <button type="submit" class="border border-red-300 bg-white px-3 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">Supprimer le crédit</button>
                    </form>
                {% endif %}
                {% if is_granted('ROLE_17B_ADMIN') or is_granted('ROLE_17B_USER') %}
                    <a class="bg-brand-primary px-3 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover" href="{{ path('time_credit_intervention_new', { id: credit.id }) }}">Nouvelle intervention</a>
                {% endif %}
            </div>
            

        <!-- Historique des mouvements -->

        <div class="mt-6 col-span-2">
        <div class="overflow-x-auto overflow-hidden">
            <table class="w-full min-w-[880px] text-left text-sm">
                <thead class="bg-brand-card text-slate-600 h-[66px]">
                    <tr>
                        <th class="px-4 py-3 font-semibold text-black">Date intervention</th>
                        <th class="px-4 py-3 font-semibold text-black">Type</th>
                        <th class="px-4 py-3 font-semibold text-black">Delta</th>
                        <th class="px-4 py-3 font-semibold text-black">Description</th>
                        <th class="px-4 py-3 font-semibold text-black">Créé par</th>
                        <th class="px-4 py-3 font-semibold text-black text-right">Actions</th>
                        {# <th class="px-4 py-3 font-semibold text-black">Créé le</th> #}
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for m in movements %}
                        <tr>
                            <td class="px-4 py-3 text-slate-700">{{ m.occurredAt|date('d/m/Y') }}</td>
                            <td class="px-4 py-3 text-slate-700">
                                {% if m.type == 'allocation' %}
                                    Allocation
                                {% elseif m.type == 'intervention' %}
                                    Intervention
                                {% else %}
                                    Ajustement
                                {% endif %}
                            </td>
                            <td class="px-4 py-3 font-medium {{ m.deltaMinutes < 0 ? 'text-red-700' : 'text-green-700' }}">
                                {% set delta_display_in_hours = m.deltaMinutes|abs > 180 %}
                                <span
                                    class="cursor-help"
                                    data-tooltip-target="tc-show-delta-tooltip-{{ loop.index }}"
                                    data-tooltip-placement="top"
                                    tabindex="0"
                                >
                                    {% if delta_display_in_hours %}
                                        {{ (m.deltaMinutes / 60)|round(2) }} h
                                    {% else %}
                                        {{ m.deltaMinutes > 0 ? '+' : '' }}{{ m.deltaMinutes }} min
                                    {% endif %}
                                </span>
                                <div id="tc-show-delta-tooltip-{{ loop.index }}" role="tooltip" class="tooltip absolute z-10 invisible inline-block rounded-base border border-default bg-neutral-primary-soft px-3 py-2 text-xs text-body opacity-0 shadow-xs">
                                    {{ delta_display_in_hours ? (m.deltaMinutes > 0 ? '+' : '') ~ m.deltaMinutes ~ ' min' : (m.deltaMinutes / 60)|round(2) ~ ' h' }}
                                    <div class="tooltip-arrow" data-popper-arrow></div>
                                </div>
                            </td>
                            <td class="px-4 py-3 text-slate-700">{{ m.description ?: '—' }}</td>
                            <td class="px-4 py-3 text-slate-700">{{ m.createdBy.email }}</td>
                            <td class="px-4 py-3 text-right">
                                {% if m.type == 'intervention' and is_granted('TIME_CREDIT_INTERVENTION_MANAGE', m) %}
                                    <div class="inline-flex items-center gap-2">
                                        <a href="{{ path('time_credit_intervention_edit', { id: credit.id, movementId: m.id }) }}" title="Modifier l'intervention" class="text-brand hover:text-brand-primary-hover">
                                            <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/></svg>
                                        </a>
                                        <form class="inline-flex" method="post" action="{{ path('time_credit_intervention_delete', { id: credit.id, movementId: m.id }) }}" onsubmit="return confirm('Supprimer cette intervention ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_time_credit_intervention' ~ m.id) }}">
                                            <button type="submit" title="Supprimer l'intervention" class="cursor-pointer text-red-700 hover:text-red-900">
                                                <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                {% elseif is_granted('ROLE_17B_ADMIN') and (m.type == 'adjustment' or (m.type == 'allocation' and allocation_count > 1)) %}
                                    <form class="inline-flex" method="post" action="{{ path('time_credit_movement_delete', { id: credit.id, movementId: m.id }) }}" onsubmit="return confirm('Supprimer cette ligne d’historique ? Le total et le solde seront recalculés.');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_time_credit_movement' ~ m.id) }}">
                                        <button type="submit" title="Supprimer cette ligne" class="cursor-pointer text-red-700 hover:text-red-900">
                                            <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="text-slate-300">—</span>
                                {% endif %}
                            </td>
                            {# <td class="px-4 py-3 text-slate-700">{{ m.createdAt|date('d/m/Y H:i') }}</td> #}
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="px-4 py-6 text-slate-600">Aucun mouvement pour le moment.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        </div>
        <!-- Fin Historique des mouvements -->

        <div class="mt-6 p-4 ring-2 ring-black md:p-6">
            <h2 class="text-base font-semibold text-brand">Répartition du crédit temps</h2>
            <p class="mt-1 text-sm text-slate-600">Visualisation donut (Flowbite Charts) du temps consommé et du temps disponible.</p>

            <div class="mt-4 grid gap-4 lg:grid-cols-3 lg:items-center">
                <div class="lg:col-span-2">
                    <div
                        class="min-h-[320px] w-full"
                        data-time-credit-donut-chart
                        data-chart-height="320"
                        data-total-minutes="{{ credit.totalMinutes }}"
                        data-consumed-minutes="{{ consumed_minutes }}"
                        data-remaining-minutes="{{ credit.remainingMinutes }}"
                    ></div>
                </div>
                <div class="space-y-3 text-sm">
                    <div class="bg-white px-3 py-2 ring-1 ring-slate-200">
                        <div class="text-slate-500">Consommé</div>
                        <div class="mt-1 font-semibold text-red-700">
                            {% set consumed_display_in_hours = consumed_minutes > 180 %}
                            <span
                                class="cursor-help"
                                data-tooltip-target="tc-show-consumed-tooltip"
                                data-tooltip-placement="top"
                                tabindex="0"
                            >
                                {{ consumed_display_in_hours ? (consumed_minutes / 60)|round(2) ~ ' h' : consumed_minutes ~ ' min' }}
                            </span>
                            <div id="tc-show-consumed-tooltip" role="tooltip" class="tooltip absolute z-10 invisible inline-block rounded-base border border-default bg-neutral-primary-soft px-3 py-2 text-xs text-body opacity-0 shadow-xs">
                                {{ consumed_display_in_hours ? consumed_minutes ~ ' min' : (consumed_minutes / 60)|round(2) ~ ' h' }}
                                <div class="tooltip-arrow" data-popper-arrow></div>
                            </div>
                            {% if credit.totalMinutes > 0 %}
                                ({{ ((consumed_minutes / credit.totalMinutes) * 100)|round(1) }} %)
                            {% endif %}
                        </div>
                    </div>
                    <div class="bg-white px-3 py-2 ring-1 ring-slate-200">
                        <div class="text-slate-500">Disponible</div>
                        <div class="mt-1 font-semibold {{ credit.remainingMinutes <= 0 ? 'text-red-700' : 'text-slate-900' }}">
                            {% set remaining_detail_display_in_hours = credit.remainingMinutes > 180 %}
                            <span
                                class="cursor-help"
                                data-tooltip-target="tc-show-remaining-detail-tooltip"
                                data-tooltip-placement="top"
                                tabindex="0"
                            >
                                {{ remaining_detail_display_in_hours ? (credit.remainingMinutes / 60)|round(2) ~ ' h' : credit.remainingMinutes ~ ' min' }}
                            </span>
                            <div id="tc-show-remaining-detail-tooltip" role="tooltip" class="tooltip absolute z-10 invisible inline-block rounded-base border border-default bg-neutral-primary-soft px-3 py-2 text-xs text-body opacity-0 shadow-xs">
                                {{ remaining_detail_display_in_hours ? credit.remainingMinutes ~ ' min' : (credit.remainingMinutes / 60)|round(2) ~ ' h' }}
                                <div class="tooltip-arrow" data-popper-arrow></div>
                            </div>
                            {% if credit.totalMinutes > 0 %}
                                ({{ ((credit.remainingMinutes / credit.totalMinutes) * 100)|round(1) }} %)
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Fin Répartition du crédit temps -->
        </div>

        
    </div>
{% endblock %}

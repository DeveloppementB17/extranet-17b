{% extends 'recette/base.html.twig' %}

{% block title %}Recette — {{ session.tester_first_name }} ({{ role_label }}){% endblock %}

{% block head %}
    <script>
        window.recetteSaveUrl = {{ path('recette_session_save', { id: session.id })|json_encode|raw }};
    </script>
    <script src="{{ asset('recette/checklist.js') }}" defer></script>
{% endblock %}

{% block body %}
    {% set responses = session.responses|default({}) %}
    {% set total = responses|length %}
    {% set valide = 0 %}
    {% set en_cours = 0 %}
    {% for r in responses %}
        {% if r.status == 'valide' %}{% set valide = valide + 1 %}
        {% elseif r.status == 'en_cours' %}{% set en_cours = en_cours + 1 %}{% endif %}
    {% endfor %}
    {% set percent = total > 0 ? ((valide / total) * 100)|round : 0 %}

    <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
        <div>
            <h1 class="font-['Sora',sans-serif] text-2xl font-extrabold">{{ session.tester_first_name }}</h1>
            <p class="mt-1 text-slate-600">{{ role_label }} · <code class="text-xs">{{ session.role }}</code></p>
            <p class="mt-1 text-sm text-slate-500">Dernière sauvegarde : {{ session.updated_at|date('d/m/Y à H:i') }}</p>
        </div>
        <div class="text-right text-sm">
            <p id="recette-progress-text" class="font-semibold">{{ valide }}/{{ total }} validé(s) ({{ percent }} %)</p>
            <p id="recette-save-hint" class="recette-save-hint mt-1">Modifications enregistrées automatiquement</p>
        </div>
    </div>

    <div class="mb-6 h-2 overflow-hidden rounded-full bg-neutral-200">
        <div id="recette-progress-bar" class="h-full bg-green-600 transition-all duration-300" style="width: {{ percent }}%"></div>
    </div>

    <form id="recette-checklist-form" method="post" action="{{ path('recette_session_save', { id: session.id }) }}">
        <div class="mb-6 flex flex-wrap items-end gap-4 rounded-lg border border-neutral-200 bg-white p-4">
            <div class="min-w-[12rem] flex-1">
                <label for="tester_first_name" class="mb-1 block text-xs font-semibold uppercase text-slate-500">Prénom</label>
                <input type="text" id="tester_first_name" name="tester_first_name" value="{{ session.tester_first_name }}"
                       maxlength="80" class="w-full rounded border border-neutral-300 px-3 py-2 text-sm">
            </div>
            <button type="submit" class="rounded border border-neutral-300 px-4 py-2 text-sm font-medium hover:bg-neutral-50">
                Enregistrer maintenant
            </button>
            <a href="{{ path('recette_session_export', { id: session.id }) }}" class="rounded border border-neutral-300 px-4 py-2 text-sm hover:bg-neutral-50">
                Télécharger JSON
            </a>
        </div>

        {% for section in sections %}
            <section class="mb-8">
                <h2 class="mb-3 font-['Sora',sans-serif] text-lg font-extrabold border-b border-neutral-200 pb-2">
                    {{ section.title }}
                </h2>
                <ul class="space-y-4">
                    {% for item in section.items %}
                        {% set itemResponse = responses[item.id]|default({ status: 'non_verifie', comment: '' }) %}
                        <li class="recette-item" data-status="{{ itemResponse.status }}">
                            <div class="flex flex-wrap items-start justify-between gap-3">
                                <div class="min-w-0 flex-1">
                                    <p class="font-semibold text-slate-900">{{ item.label }}</p>
                                    {% if item.detail is defined %}
                                        <div class="mt-1 text-sm text-slate-600 whitespace-pre-line leading-relaxed">{{ item.detail }}</div>
                                    {% endif %}
                                </div>
                                <select name="items[{{ item.id }}][status]"
                                        class="recette-status-select shrink-0 rounded border border-neutral-300 px-2 py-1.5 text-sm font-medium"
                                        aria-label="Statut pour {{ item.label }}">
                                    {% for status in statuses %}
                                        <option value="{{ status.id }}" {{ itemResponse.status == status.id ? 'selected' : '' }}>
                                            {{ status.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <label class="mt-3 block text-xs font-semibold text-slate-500" for="comment-{{ item.id }}">Commentaire</label>
                            <textarea id="comment-{{ item.id }}" name="items[{{ item.id }}][comment]" rows="2"
                                      class="recette-comment mt-1 w-full rounded border border-neutral-200 px-3 py-2 text-sm"
                                      placeholder="Observations, bug, URL testée…">{{ itemResponse.comment }}</textarea>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endfor %}

        <div class="sticky bottom-0 -mx-1 flex flex-wrap items-center justify-between gap-3 border-t border-neutral-200 bg-[#f8f8f8]/95 py-4 backdrop-blur">
            <button type="submit" class="rounded bg-black px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800">
                Enregistrer la checklist
            </button>
            <a href="{{ path('recette_index') }}" class="text-sm text-slate-600 hover:underline">Retour aux sessions</a>
        </div>
    </form>

    <section class="mt-8 rounded-lg border border-red-200 bg-red-50/50 p-4">
        <h2 class="text-sm font-semibold text-red-900">Supprimer cette checklist</h2>
        <p class="mt-1 text-sm text-red-800/90">Le fichier JSON sera définitivement effacé du serveur. Action irréversible.</p>
        <form method="post" action="{{ path('recette_session_delete', { id: session.id }) }}" class="mt-3"
              onsubmit="return confirm('Supprimer définitivement la checklist de {{ session.tester_first_name|e('js') }} ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('recette_delete_' ~ session.id) }}">
            <button type="submit" class="rounded border border-red-300 bg-white px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-50">
                Supprimer la checklist
            </button>
        </form>
    </section>
{% endblock %}

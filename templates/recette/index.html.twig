{% extends 'recette/base.html.twig' %}

{% block title %}Sessions de recette — Extranet 17b{% endblock %}

{% block body %}
    <section class="mb-10 rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
        <h1 class="font-['Sora',sans-serif] text-2xl font-extrabold">Checklist de recette</h1>
        <p class="mt-2 text-slate-600">
            Créez une session avec votre prénom et le rôle testé. Chaque point peut être marqué
            <span class="recette-badge recette-badge--non_verifie">Non vérifié</span>,
            <span class="recette-badge recette-badge--en_cours">En cours</span> ou
            <span class="recette-badge recette-badge--valide">Validé</span>, avec un commentaire libre.
        </p>
        <p class="mt-3 text-sm text-slate-500">
            Les enregistrements sont stockés en JSON sur le serveur (<code class="text-xs">var/recette/sessions/</code>).
        </p>
        <a href="{{ path('recette_new') }}" class="mt-5 inline-flex rounded bg-black px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-800">
            Démarrer une nouvelle recette
        </a>
    </section>

    <section>
        <h2 class="mb-4 font-['Sora',sans-serif] text-lg font-extrabold">Sessions enregistrées</h2>

        {% if sessions is empty %}
            <p class="rounded border border-dashed border-neutral-300 bg-white p-6 text-slate-500">
                Aucune session pour le moment.
            </p>
        {% else %}
            <ul class="space-y-3">
                {% for session in sessions %}
                    {% set roleLabel = '' %}
                    {% for role in definition.roles %}
                        {% if role.id == session.role %}
                            {% set roleLabel = role.label %}
                        {% endif %}
                    {% endfor %}
                    {% set responses = session.responses|default({}) %}
                    {% set total = responses|length %}
                    {% set valide = 0 %}
                    {% for r in responses %}
                        {% if r.status == 'valide' %}{% set valide = valide + 1 %}{% endif %}
                    {% endfor %}
                    <li class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-neutral-200 bg-white p-4">
                        <div>
                            <p class="font-semibold">{{ session.tester_first_name }} — {{ roleLabel|default(session.role) }}</p>
                            <p class="text-sm text-slate-500">
                                Modifié le {{ session.updated_at|default(session.created_at)|date('d/m/Y H:i') }}
                                · {{ valide }}/{{ total }} validé(s)
                            </p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <a href="{{ path('recette_session', { id: session.id }) }}" class="rounded border border-neutral-300 px-3 py-1.5 text-sm font-medium hover:bg-neutral-50">
                                Reprendre
                            </a>
                            <form method="post" action="{{ path('recette_session_delete', { id: session.id }) }}" class="inline"
                                  onsubmit="return confirm('Supprimer la checklist de {{ session.tester_first_name|e('js') }} ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('recette_delete_' ~ session.id) }}">
                                <button type="submit" class="rounded border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50">
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="mt-10 rounded-lg border border-neutral-200 bg-white p-6">
        <h2 class="mb-3 font-['Sora',sans-serif] text-lg font-extrabold">Rôles couverts</h2>
        <ul class="grid gap-2 sm:grid-cols-2 text-sm text-slate-700">
            {% for role in definition.roles %}
                <li><span class="font-medium">{{ role.label }}</span> — <code class="text-xs">{{ role.id }}</code></li>
            {% endfor %}
        </ul>
    </section>
{% endblock %}

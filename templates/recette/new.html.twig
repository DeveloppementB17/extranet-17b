{% extends 'recette/base.html.twig' %}

{% block title %}Nouvelle session de recette{% endblock %}

{% block body %}
    <section class="max-w-lg rounded-lg border border-neutral-200 bg-white p-6 shadow-sm">
        <h1 class="font-['Sora',sans-serif] text-xl font-extrabold">Nouvelle session</h1>
        <p class="mt-2 text-sm text-slate-600">Indiquez qui réalise la recette et avec quel rôle vous vous connecterez sur l'extranet.</p>

        <form method="post" action="{{ path('recette_new') }}" class="mt-6 space-y-5">
            <div>
                <label for="tester_first_name" class="mb-1 block text-sm font-semibold">Prénom du testeur</label>
                <input type="text" id="tester_first_name" name="tester_first_name" value="{{ tester_first_name }}"
                       required autocomplete="given-name" maxlength="80"
                       class="w-full rounded border border-neutral-300 px-3 py-2 text-sm focus:border-black focus:outline-none focus:ring-1 focus:ring-black"
                       placeholder="Ex. Marie">
            </div>

            <div>
                <label for="role" class="mb-1 block text-sm font-semibold">Rôle de recette</label>
                <select id="role" name="role" required
                        class="w-full rounded border border-neutral-300 px-3 py-2 text-sm focus:border-black focus:outline-none focus:ring-1 focus:ring-black">
                    <option value="">— Choisir un rôle —</option>
                    {% for r in roles %}
                        <option value="{{ r.id }}" {{ role == r.id ? 'selected' : '' }}>{{ r.label }}</option>
                    {% endfor %}
                </select>
                <p class="mt-2 text-xs text-slate-500">La checklist affichera uniquement les points applicables à ce rôle.</p>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit" class="rounded bg-black px-4 py-2 text-sm font-semibold text-white hover:bg-neutral-800">
                    Créer la checklist
                </button>
                <a href="{{ path('recette_index') }}" class="rounded border border-neutral-300 px-4 py-2 text-sm hover:bg-neutral-50">Annuler</a>
            </div>
        </form>

        <div class="mt-8 border-t border-neutral-100 pt-6">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Aide comptes de test</p>
            <ul class="mt-2 space-y-1 text-xs text-slate-600">
                {% for r in roles %}
                    {% if r.hint is defined %}
                        <li><strong>{{ r.label }} :</strong> {{ r.hint }}</li>
                    {% endif %}
                {% endfor %}
            </ul>
        </div>
    </section>
{% endblock %}

{% extends 'auth/_layout.html.twig' %}

{% block title %}Connexion par code{% endblock %}

{% block auth_body %}
        <h1 class="text-3xl font-extrabold text-brand">Connexion</h1>
        <p class="mt-3 text-sm text-slate-600">
            Saisissez votre email. Si un compte existe, un code unique vous sera envoyé.
        </p>

        {{ include('auth/_dev_mail_notice.html.twig') }}

        {% for message in app.flashes('success') %}
            <div class="mt-6 rounded border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mt-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        <form class="mt-8 space-y-6" action="{{ path('auth_code') }}" method="post">
            <div class="relative z-0 w-full mb-5 group">
                <input class="block pt-2.5 pb-1 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium appearance-none focus:outline-none focus:ring-0 peer"
                       type="email" id="email" name="email" autocomplete="email" required placeholder=" ">
                <label class="absolute z-10 text-lg font-semibold text-brand duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 peer-focus:bg-black peer-focus:text-white peer-focus:px-2
                 peer-focus:text-fg-brand peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto"
                       for="email">Identifiant</label>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <button class="ml-auto block bg-brand-primary px-6 py-2 text-sm font-bold text-white hover:bg-brand-primary-hover button" type="submit">
                Connexion
            </button>
        </form>

        <div class="mt-6 text-center text-m text-slate-600">
            <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('app_login') }}">Connexion par mot de passe</a>
        </div>
{% endblock %}


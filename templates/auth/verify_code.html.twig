{% extends 'auth/_layout.html.twig' %}

{% block title %}Saisir le code{% endblock %}

{% block auth_body %}
        <h1 class="text-3xl font-extrabold text-brand">Connexion</h1>
        <p class="mt-3 text-center text-sm text-slate-600">
            Saisis le code à 6 chiffres reçu par email.
        </p>

        {% if app.environment == 'dev' %}
            <div class="mt-4 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                <div class="font-semibold">Mode dev</div>
                <div class="mt-1">
                    Tu peux récupérer le code dans Mailhog/Mailpit :
                    <a class="font-medium underline" href="http://127.0.0.1:8025" target="_blank" rel="noopener noreferrer">ouvrir l’interface email</a>.
                </div>
            </div>
        {% endif %}

        {% for message in app.flashes('error') %}
            <div class="mt-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('success') %}
            <div class="mt-6 rounded border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
        {% endfor %}

        <form class="mt-8 space-y-6" action="{{ path('auth_code_verify') }}" method="post">
            <div class="relative z-0 w-full mb-5 group">
                <input class="block pt-2.5 pb-1 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium appearance-none focus:outline-none focus:ring-0 peer"
                       type="email" id="email" name="email" value="{{ email }}" autocomplete="email" required placeholder=" ">
                <label class="absolute text-lg font-semibold text-brand duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 peer-focus:bg-black peer-focus:text-white peer-focus:px-2
                 peer-focus:text-fg-brand peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto"
                       for="email">Identifiant</label>
            </div>

            <div class="relative z-0 w-full mb-5 group">
                <input class="block py-2.5 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium appearance-none focus:outline-none focus:ring-0 tracking-widest peer"
                       type="text" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required placeholder=" ">
                <label class="absolute z-10 text-lg font-semibold text-brand duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 peer-focus:bg-black peer-focus:text-white peer-focus:px-2
                 peer-focus:text-fg-brand peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto"
                       for="code">Code unique</label>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">

            <button class="ml-auto block bg-brand-primary px-6 py-2 text-sm font-bold text-white hover:bg-brand-primary-hover button" type="submit">
                Connexion
            </button>
        </form>

        <div class="mt-6 text-center text-sm text-slate-600">
            <a class="font-medium text-brand underline" href="{{ path('auth_code') }}">Renvoyer un code</a>
        </div>
{% endblock %}


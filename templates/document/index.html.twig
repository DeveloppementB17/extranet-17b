{% extends 'base.html.twig' %}
{% import 'document/_tree.html.twig' as doc_tree %}
{% import 'document/_preview_macros.html.twig' as doc_preview %}

{% block title %}Documents{% endblock %}

{% block body %}
    {% for message in app.flashes('success') %}
        <div class="mb-6 rounded border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mb-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
    {% endfor %}

    <nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">Fichiers</span>
    </nav>

    <p class="mt-6 text-m">
            <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('app_home') }}">← Retour au tableau de bord</a>
        </p>

    <div class="panel mt-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-5xl font-extrabold text-brand">Fichiers</h1>
            {% if can_upload %}
                <a class="bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover" href="{{ path('document_batch_upload') }}">
                    Ajouter un document
                </a>
            {% endif %}
        </div>

        {% if is_admin_list_view %}
            <form method="get" class="mt-6 grid gap-3 grid-cols-1 md:grid-cols-2 xl:grid-cols-4 2xl:grid-cols-4">
                <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher un fichier..." class="border border-black px-3 py-2 text-sm">
                <select name="entreprise" class="border border-black px-3 py-2 text-sm">
                    <option value="0">Toutes les entreprises</option>
                    {% for id, name in available_entreprises %}
                        <option value="{{ id }}" {{ filter_entreprise == id ? 'selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
                <select name="category" class="border border-black px-3 py-2 text-sm">
                    <option value="0">Toutes les catégories</option>
                    {% for id, name in available_categories %}
                        <option value="{{ id }}" {{ filter_category == id ? 'selected' : '' }}>{{ name }}</option>
                    {% endfor %}
                </select>
                <div class="flex gap-2 justify-end">
                    <button type="submit" class="cursor-pointer bg-brand-primary px-4 py-2 text-sm font-semibold text-white">Filtrer</button>

                    <a href="{{ path('document_index') }}" class="border border-black px-4 py-2 text-sm font-semibold text-slate-700">Réinitialiser</a>
                </div>
                <input type="hidden" name="sort" value="{{ sort_field }}">
                <input type="hidden" name="dir" value="{{ sort_direction }}">
            </form>

            {% if can_bulk_delete %}
                <form id="doc-bulk-form" method="post" action="{{ path('document_bulk_delete', app.request.query.all) }}" class="hidden" tabindex="-1" aria-hidden="true">
                    <input type="hidden" name="_token" value="{{ csrf_token('document_bulk_delete') }}">
                </form>
                <div class="mt-4 flex flex-wrap items-center gap-3" id="doc-bulk-controls">
                    <button type="button" id="doc-bulk-enter" class="cursor-pointer border border-black px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-neutral-50">
                        Sélection multiple
                    </button>
                    <div id="doc-bulk-panel" class="hidden flex flex-wrap items-center gap-4 border border-slate-200 bg-slate-50 px-4 py-3">
                        <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                            <input id="doc-bulk-select-all" type="checkbox" class="h-4 w-4 rounded border-slate-400 text-brand-primary focus:ring-brand-primary">
                            Tout sélectionner
                        </label>
                        <button
                            type="submit"
                            form="doc-bulk-form"
                            id="doc-bulk-delete"
                            class="cursor-pointer bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800 disabled:cursor-not-allowed disabled:opacity-50"
                            disabled
                        >
                            Supprimer la sélection
                        </button>
                        <button type="button" id="doc-bulk-cancel" class="cursor-pointer border border-black px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-white">
                            Annuler
                        </button>
                    </div>
                </div>
            {% endif %}

            <div class="mt-6 overflow-x-auto overflow-hidden ring-1 ring-slate-200"{% if can_bulk_delete %} id="doc-bulk-table-wrap"{% endif %}>
                <table class="w-full min-w-[960px] text-left text-sm">
                    <thead class="bg-brand-card text-slate-600 h-[66px]">
                        <tr>
                            {% set nextTitleDir = sort_field == 'title' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                            {% set nextEntrepriseDir = sort_field == 'entreprise' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                            {% set nextCategoryDir = sort_field == 'category' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                            {% set nextDateDir = sort_field == 'created_at' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                            {% if can_bulk_delete %}
                                <th class="doc-bulk-col hidden w-10 px-4 py-3 font-semibold text-black" scope="col">
                                    <span class="sr-only">Sélection</span>
                                </th>
                            {% endif %}
                            <th class="w-16 px-4 py-3 font-semibold text-black">Aperçu</th>
                            <th class="px-4 py-3 font-semibold">
                                <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('document_index', app.request.query.all|merge({ sort: 'title', dir: nextTitleDir })) }}">
                                    Titre
                                    {% if sort_field == 'title' %}
                                        <svg class="h-3.5 w-3.5 text-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-label="Tri {{ sort_direction == 'asc' ? 'croissant' : 'décroissant' }}">
                                            {% if sort_direction == 'asc' %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            {% else %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                            {% endif %}
                                        </svg>
                                    {% else %}
                                        <svg class="h-3.5 w-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                        </svg>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 font-semibold">
                                <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('document_index', app.request.query.all|merge({ sort: 'entreprise', dir: nextEntrepriseDir })) }}">
                                    Entreprise
                                    {% if sort_field == 'entreprise' %}
                                        <svg class="h-3.5 w-3.5 text-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-label="Tri {{ sort_direction == 'asc' ? 'croissant' : 'décroissant' }}">
                                            {% if sort_direction == 'asc' %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            {% else %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                            {% endif %}
                                        </svg>
                                    {% else %}
                                        <svg class="h-3.5 w-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                        </svg>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 font-semibold">
                                <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('document_index', app.request.query.all|merge({ sort: 'category', dir: nextCategoryDir })) }}">
                                    Catégorie
                                    {% if sort_field == 'category' %}
                                        <svg class="h-3.5 w-3.5 text-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-label="Tri {{ sort_direction == 'asc' ? 'croissant' : 'décroissant' }}">
                                            {% if sort_direction == 'asc' %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            {% else %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                            {% endif %}
                                        </svg>
                                    {% else %}
                                        <svg class="h-3.5 w-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                        </svg>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 font-semibold">
                                <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('document_index', app.request.query.all|merge({ sort: 'created_at', dir: nextDateDir })) }}">
                                    Date
                                    {% if sort_field == 'created_at' %}
                                        <svg class="h-3.5 w-3.5 text-brand" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-label="Tri {{ sort_direction == 'asc' ? 'croissant' : 'décroissant' }}">
                                            {% if sort_direction == 'asc' %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            {% else %}
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                            {% endif %}
                                        </svg>
                                    {% else %}
                                        <svg class="h-3.5 w-3.5 text-slate-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 15l4-4 4 4"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l4 4 4-4"/>
                                        </svg>
                                    {% endif %}
                                </a>
                            </th>
                            <th class="px-4 py-3 font-semibold text-black text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200 bg-white">
                        {% for document in documents %}
                            <tr class="hover:bg-neutral-50">
                                {% if can_bulk_delete and is_granted('DOCUMENT_MANAGE', document) %}
                                    <td class="doc-bulk-col hidden px-4 py-3">
                                        <input
                                            type="checkbox"
                                            form="doc-bulk-form"
                                            name="document_ids[]"
                                            value="{{ document.id }}"
                                            class="doc-bulk-checkbox h-4 w-4 rounded border-slate-400 text-brand-primary focus:ring-brand-primary"
                                            aria-label="Sélectionner {{ document.title }}"
                                        >
                                    </td>
                                {% elseif can_bulk_delete %}
                                    <td class="doc-bulk-col hidden px-4 py-3" aria-hidden="true"></td>
                                {% endif %}
                                <td class="px-4 py-3">
                                    {{ doc_preview.preview_cell(document) }}
                                </td>
                                <td class="px-4 py-3 text-slate-900">{{ document.title }}</td>
                                <td class="px-4 py-3 text-slate-700">{{ document.entreprise ? document.entreprise.name : '—' }}</td>
                                <td class="px-4 py-3 text-slate-700">{{ document.category ? document.category.name : '—' }}</td>
                                <td class="px-4 py-3 text-slate-700">{{ document.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="px-4 py-3 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <a href="{{ doc_preview.preview_open_url(document) }}" title="Ouvrir" class="text-brand hover:text-brand-primary-hover"{% if not document.externalLink %} target="_blank" rel="noopener noreferrer"{% endif %}>
                                            <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-width="2" d="M21 12c0 1.2-4.03 6-9 6s-9-4.8-9-6c0-1.2 4.03-6 9-6s9 4.8 9 6Z"/><path stroke="currentColor" stroke-width="2" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
                                        </a>
                                        {% if (is_granted('ROLE_17B_ADMIN') or is_granted('ROLE_17B_USER')) and is_granted('DOCUMENT_MANAGE', document) %}
                                            <a href="{{ path('document_edit', { id: document.id }) }}" title="Modifier" class="text-brand hover:text-brand-primary-hover">
                                                <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/></svg>
                                            </a>
                                            <form class="inline-flex" method="post" action="{{ path('document_delete', { id: document.id }) }}" onsubmit="return confirm('Supprimer ce document ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_document' ~ document.id) }}">
                                                <button type="submit" title="Supprimer" class="cursor-pointer text-red-700 hover:text-red-900">
                                                    <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="{{ can_bulk_delete ? 7 : 6 }}" class="px-4 py-6 text-slate-600">Aucun document ne correspond aux filtres.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% elseif documents is empty %}
            <p class="mt-6 font-['Proxima_Nova','Inter',sans-serif] text-base text-neutral-600">Aucun document pour le moment.</p>
        {% else %}
            <div class="mt-6 document-tree-maquette max-w-none text-black">
                {% for root in category_roots %}
                    {{ doc_tree.category_branch(root, documents_by_category, show_client_in_tree, 0, can_upload, loop.first) }}
                {% endfor %}
                {{ doc_tree.uncategorized(documents_by_category, show_client_in_tree, can_upload, category_roots is empty) }}
            </div>
        {% endif %}

        {% if can_bulk_delete %}
            <script>
                (() => {
                    const enterBtn = document.getElementById('doc-bulk-enter');
                    const panel = document.getElementById('doc-bulk-panel');
                    const cancelBtn = document.getElementById('doc-bulk-cancel');
                    const selectAll = document.getElementById('doc-bulk-select-all');
                    const deleteBtn = document.getElementById('doc-bulk-delete');
                    const bulkForm = document.getElementById('doc-bulk-form');
                    const bulkCols = Array.from(document.querySelectorAll('.doc-bulk-col'));
                    const checkboxes = () => Array.from(document.querySelectorAll('.doc-bulk-checkbox'));

                    const updateDeleteButton = () => {
                        if (!deleteBtn) {
                            return;
                        }
                        deleteBtn.disabled = checkboxes().every((cb) => !cb.checked);
                    };

                    const setBulkMode = (active) => {
                        enterBtn.classList.toggle('hidden', active);
                        panel.classList.toggle('hidden', !active);
                        bulkCols.forEach((cell) => cell.classList.toggle('hidden', !active));
                        if (!active) {
                            checkboxes().forEach((cb) => {
                                cb.checked = false;
                            });
                            if (selectAll) {
                                selectAll.checked = false;
                            }
                            updateDeleteButton();
                        }
                    };

                    enterBtn?.addEventListener('click', () => setBulkMode(true));
                    cancelBtn?.addEventListener('click', () => setBulkMode(false));

                    selectAll?.addEventListener('change', () => {
                        checkboxes().forEach((cb) => {
                            cb.checked = selectAll.checked;
                        });
                        updateDeleteButton();
                    });

                    document.addEventListener('change', (event) => {
                        if (event.target instanceof HTMLInputElement && event.target.classList.contains('doc-bulk-checkbox')) {
                            updateDeleteButton();
                            if (selectAll) {
                                const boxes = checkboxes();
                                selectAll.checked = boxes.length > 0 && boxes.every((cb) => cb.checked);
                            }
                        }
                    });

                    bulkForm?.addEventListener('submit', (event) => {
                        const count = checkboxes().filter((cb) => cb.checked).length;
                        if (count === 0) {
                            event.preventDefault();
                            return;
                        }
                        const label = count === 1 ? '1 document' : `${count} documents`;
                        if (!window.confirm(`Supprimer ${label} ? Cette action est irréversible.`)) {
                            event.preventDefault();
                        }
                    });
                })();
            </script>
        {% endif %}
        
    </div>
{% endblock %}

{% macro document_month_year(date) -%}
    {%- set mois = {
        1: 'janvier', 2: 'février', 3: 'mars', 4: 'avril',
        5: 'mai', 6: 'juin', 7: 'juillet', 8: 'août',
        9: 'septembre', 10: 'octobre', 11: 'novembre', 12: 'décembre'
    } -%}
    {{- mois[date|date('n') + 0] }} {{ date|date('Y') -}}
{%- endmacro %}

{% macro preview_open_url(document) -%}
    {%- if document.externalLink -%}
        {{- path('document_download', { id: document.id }) -}}
    {%- elseif document.mimeType starts with 'image/' or document.mimeType == 'application/pdf' or document.mimeType starts with 'text/' or document.mimeType == 'application/json' or document.mimeType == 'application/ld+json' or (document.originalName|lower ends with '.pdf') or (document.originalName|lower ends with '.json') or (document.originalName|lower ends with '.txt') or (document.originalName|lower ends with '.csv') or (document.originalName|lower ends with '.xml') or (document.originalName|lower ends with '.md') or (document.title|lower ends with '.pdf') or (document.title|lower ends with '.json') -%}
        {{- path('document_preview', { id: document.id }) -}}
    {%- else -%}
        {{- path('document_download', { id: document.id }) -}}
    {%- endif -%}
{%- endmacro %}

{% macro preview_type_label(document) -%}
    {%- if document.externalLink -%}
        URL
    {%- else -%}
        {%- set source = (document.originalName ?: document.title)|lower -%}
        {%- set ext = source|split('.')|last -%}
        {%- if document.mimeType == 'application/pdf' or ext == 'pdf' -%}
            PDF
        {%- elseif document.mimeType == 'application/json' or document.mimeType == 'application/ld+json' or ext == 'json' -%}
            JSON
        {%- elseif document.mimeType starts with 'text/' or ext in ['txt', 'csv', 'xml', 'md'] -%}
            {{ ext == 'csv' ? 'CSV' : (ext == 'xml' ? 'XML' : (ext == 'md' ? 'MD' : 'TXT')) }}
        {%- elseif ext in ['doc', 'docx'] -%}
            {{ ext|upper }}
        {%- elseif ext in ['xls', 'xlsx'] -%}
            {{ ext|upper }}
        {%- elseif ext in ['ppt', 'pptx'] -%}
            {{ ext|upper }}
        {%- elseif ext in ['zip', 'rar', '7z'] -%}
            {{ ext|upper }}
        {%- elseif ext|length > 0 and ext|length <= 5 and '.' in source -%}
            {{ ext|upper }}
        {%- else -%}
            FICHIER
        {%- endif -%}
    {%- endif -%}
{%- endmacro %}

{% macro preview_cell(document) %}
    {% set type_label = _self.preview_type_label(document) %}
    {% if document.externalLink %}
        <a href="{{ _self.preview_open_url(document) }}" target="_blank" rel="noopener noreferrer" class="inline-flex h-10 w-10 items-center justify-center rounded bg-sky-50 text-[10px] font-bold uppercase text-sky-800" title="Lien externe">{{ type_label }}</a>
    {% elseif document.mimeType starts with 'image/' %}
        <a href="{{ path('document_preview', { id: document.id }) }}" target="_blank" rel="noopener noreferrer" title="Aperçu">
            <img src="{{ path('document_preview', { id: document.id }) }}" alt="" class="h-10 w-10 rounded object-cover" loading="lazy">
        </a>
    {% elseif type_label == 'PDF' %}
        <a href="{{ path('document_preview', { id: document.id }) }}" target="_blank" rel="noopener noreferrer" class="inline-flex h-10 w-10 items-center justify-center rounded bg-red-50 text-xs font-bold uppercase text-red-700" title="Aperçu PDF">PDF</a>
    {% elseif type_label in ['JSON', 'TXT', 'CSV', 'XML', 'MD'] %}
        <a href="{{ path('document_preview', { id: document.id }) }}" target="_blank" rel="noopener noreferrer" class="inline-flex h-10 w-10 items-center justify-center rounded bg-sky-50 text-[10px] font-bold uppercase text-sky-800" title="Aperçu texte">{{ type_label }}</a>
    {% else %}
        <a href="{{ _self.preview_open_url(document) }}" target="_blank" rel="noopener noreferrer" class="inline-flex h-10 w-10 items-center justify-center rounded bg-sky-50 text-[9px] font-bold uppercase leading-tight text-sky-800" title="{{ type_label }}">{{ type_label }}</a>
    {% endif %}
{% endmacro %}

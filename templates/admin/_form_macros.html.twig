{% macro field_errors(field) %}
    {{ form_errors(field, { attr: { class: 'mt-2 list-inside list-disc space-y-1 text-sm font-semibold text-red-700' } }) }}
{% endmacro %}

{% macro form_errors_all(form) %}
    {{ form_errors(form, { attr: { class: 'mb-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800' } }) }}
{% endmacro %}

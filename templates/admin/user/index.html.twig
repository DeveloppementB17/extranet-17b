{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
    <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
    <span class="text-neutral-400"> / </span>
    <span class="font-medium" aria-current="page">Utilisateurs</span>
</nav>
<p class="mt-6 text-m">
            <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_dashboard') }}">← Retour à l’administration</a>
        </p>
        
    <div class="panel py-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-5xl font-extrabold text-brand">Utilisateurs</h1>
            <a class="bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover" href="{{ path('admin_user_new') }}">Nouvel utilisateur</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mt-4 border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        <form method="get" class="mt-6 grid gap-3 md:grid-cols-6">
            <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher un utilisateur..." class="border border-dark px-3 py-2 text-sm md:col-span-2">
            <select name="role" class="border border-dark px-3 py-2 text-sm">
                <option value="all" {{ filter_role == 'all' ? 'selected' : '' }}>Tous les rôles</option>
                {% for role in available_roles %}
                    <option value="{{ role }}" {{ filter_role == role ? 'selected' : '' }}>{{ role|role_label }}</option>
                {% endfor %}
            </select>
            <select name="entreprise" class="border border-dark px-3 py-2 text-sm">
                <option value="0">Toutes les entreprises</option>
                {% for id, name in available_entreprises %}
                    <option value="{{ id }}" {{ filter_entreprise == id ? 'selected' : '' }}>{{ name }}</option>
                {% endfor %}
            </select>
            <div class="flex gap-2 md:col-span-2 justify-end">
                <button type="submit" class="cursor-pointer bg-brand-primary px-4 py-2 text-sm font-semibold text-white">Filtrer</button>

                <a href="{{ path('admin_user_index') }}" class="border border-dark px-4 py-2 text-sm font-semibold text-slate-700">Réinitialiser</a>
            </div>
            <input type="hidden" name="sort" value="{{ sort_field }}">
            <input type="hidden" name="dir" value="{{ sort_direction }}">
        </form>

        <form id="bulk-actions-form" method="post" action="{{ path('admin_user_bulk_update', app.request.query.all) }}" class="hidden" tabindex="-1" aria-hidden="true">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_user_bulk_update') }}">
        </form>

        <div class="mt-4 flex flex-wrap items-start gap-3" id="user-bulk-controls">
            <button type="button" id="user-bulk-enter" class="cursor-pointer border border-black px-4 py-2 text-sm font-semibold text-slate-800 hover:bg-neutral-50">
                Sélection multiple
            </button>
            <div id="user-bulk-panel" class="hidden w-full min-w-0 flex-1 space-y-4 border border-slate-200 bg-slate-50 p-4">
                <div class="grid gap-3 md:grid-cols-4">
                    <select form="bulk-actions-form" name="bulk_action" class="border border-dark px-3 py-2 text-sm" required>
                        <option value="">Action en masse…</option>
                        <option value="assign_managed_entreprise">Attribuer une entreprise gérée (utilisateurs 17b)</option>
                        <option value="set_client_role">Modifier le rôle client</option>
                        <option value="set_client_entreprise">Modifier la société cliente</option>
                    </select>
                    <select form="bulk-actions-form" name="managed_entreprise_id" class="border border-dark px-3 py-2 text-sm">
                        <option value="0">Entreprise à attribuer (17b user)</option>
                        {% for entreprise in client_entreprises %}
                            <option value="{{ entreprise.id }}">{{ entreprise.name }}</option>
                        {% endfor %}
                    </select>
                    <select form="bulk-actions-form" name="client_role" class="border border-dark px-3 py-2 text-sm">
                        <option value="">Rôle client cible</option>
                        <option value="ROLE_CUSTOMER_ADMIN">Administrateur client</option>
                        <option value="ROLE_CUSTOMER_USER">Utilisateur client</option>
                    </select>
                    <select form="bulk-actions-form" name="client_entreprise_id" class="border border-dark px-3 py-2 text-sm">
                        <option value="0">Société cliente cible</option>
                        {% for entreprise in client_entreprises %}
                            <option value="{{ entreprise.id }}">{{ entreprise.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <label class="inline-flex items-center gap-2 text-sm text-slate-700">
                        <input id="bulk-select-all" type="checkbox" class="h-4 w-4 rounded border-slate-400 text-brand-primary focus:ring-brand-primary">
                        Tout sélectionner
                    </label>
                    <div class="flex flex-wrap items-center gap-3">
                        <button
                            type="submit"
                            form="bulk-actions-form"
                            id="user-bulk-apply"
                            class="cursor-pointer bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover disabled:cursor-not-allowed disabled:opacity-50"
                            disabled
                        >
                            Appliquer l’action en masse
                        </button>
                        <button type="button" id="user-bulk-cancel" class="cursor-pointer border border-black px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-white">
                            Annuler
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-6 overflow-x-auto overflow-hidden ring-1 ring-slate-200">
            <table class="w-full min-w-[820px] text-left text-sm">
                <thead class="bg-brand-card text-slate-600 h-[66px]">
                    <tr>
                        {% set nextEmailDir = sort_field == 'email' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        {% set nextRoleDir = sort_field == 'role' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        {% set nextEntrepriseDir = sort_field == 'entreprise' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        <th class="user-bulk-col hidden w-10 px-4 py-3 font-semibold text-black" scope="col">
                            <span class="sr-only">Sélection</span>
                        </th>
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_user_index', app.request.query.all|merge({ sort: 'email', dir: nextEmailDir })) }}">Email</a>
                        </th>
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_user_index', app.request.query.all|merge({ sort: 'role', dir: nextRoleDir })) }}">Rôle</a>
                        </th>
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_user_index', app.request.query.all|merge({ sort: 'entreprise', dir: nextEntrepriseDir })) }}">Entreprise</a>
                        </th>
                        <th class="px-4 py-3 font-semibold text-black text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for u in users %}
                        <tr class="hover:bg-neutral-50">
                            <td class="user-bulk-col hidden px-4 py-3">
                                <input
                                    type="checkbox"
                                    form="bulk-actions-form"
                                    name="selected_ids[]"
                                    value="{{ u.id }}"
                                    class="bulk-user-checkbox h-4 w-4 rounded border-slate-400 text-brand-primary focus:ring-brand-primary"
                                    aria-label="Sélectionner {{ u.email }}"
                                >
                            </td>
                            <td class="px-4 py-3 font-medium text-slate-900">{{ u.email }}</td>
                            <td class="px-4 py-3 text-slate-700">{{ u.primaryStoredRole|role_label }}</td>
                            <td class="px-4 py-3 text-slate-700">{{ u.entreprise.name }}{% if u.entreprise.agency %} <span class="text-slate-500">(agence)</span>{% endif %}</td>
                            <td class="px-4 py-3 text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a href="{{ path('admin_user_edit', { id: u.id }) }}" title="Modifier" class="text-brand hover:text-brand-primary-hover">
                                        <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/></svg>
                                    </a>
                                    {% if app.user and app.user.id != u.id %}
                                        <a href="{{ path('admin_user_delete_confirm', { id: u.id }) }}" title="Supprimer" class="text-red-700 hover:text-red-900">
                                            <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                        </a>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="px-4 py-6 text-slate-600">Aucun utilisateur.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        
    </div>
    <script>
        (() => {
            const enterBtn = document.getElementById('user-bulk-enter');
            const panel = document.getElementById('user-bulk-panel');
            const cancelBtn = document.getElementById('user-bulk-cancel');
            const selectAll = document.getElementById('bulk-select-all');
            const applyBtn = document.getElementById('user-bulk-apply');
            const bulkForm = document.getElementById('bulk-actions-form');
            const bulkCols = Array.from(document.querySelectorAll('.user-bulk-col'));
            const checkboxes = () => Array.from(document.querySelectorAll('.bulk-user-checkbox'));

            const updateApplyButton = () => {
                if (!applyBtn) {
                    return;
                }
                applyBtn.disabled = checkboxes().every((cb) => !cb.checked);
            };

            const setBulkMode = (active) => {
                enterBtn?.classList.toggle('hidden', active);
                panel?.classList.toggle('hidden', !active);
                bulkCols.forEach((cell) => cell.classList.toggle('hidden', !active));
                if (!active) {
                    checkboxes().forEach((cb) => {
                        cb.checked = false;
                    });
                    if (selectAll) {
                        selectAll.checked = false;
                    }
                    updateApplyButton();
                }
            };

            enterBtn?.addEventListener('click', () => setBulkMode(true));
            cancelBtn?.addEventListener('click', () => setBulkMode(false));

            selectAll?.addEventListener('change', () => {
                checkboxes().forEach((cb) => {
                    cb.checked = selectAll.checked;
                });
                updateApplyButton();
            });

            document.addEventListener('change', (event) => {
                if (event.target instanceof HTMLInputElement && event.target.classList.contains('bulk-user-checkbox')) {
                    updateApplyButton();
                    if (selectAll) {
                        const boxes = checkboxes();
                        selectAll.checked = boxes.length > 0 && boxes.every((cb) => cb.checked);
                    }
                }
            });

            bulkForm?.addEventListener('submit', (event) => {
                const count = checkboxes().filter((cb) => cb.checked).length;
                if (count === 0) {
                    event.preventDefault();
                    return;
                }
                const label = count === 1 ? '1 utilisateur' : `${count} utilisateurs`;
                if (!window.confirm(`Appliquer l’action en masse à ${label} ?`)) {
                    event.preventDefault();
                }
            });
        })();
    </script>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
    <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
    <span class="text-neutral-400"> / </span>
    <span class="font-medium" aria-current="page">Utilisateurs</span>
</nav>
<p class="mt-6 text-m">
            <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_dashboard') }}">← Retour à l’administration</a>
        </p>
        
    <div class="panel py-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-5xl font-extrabold text-brand">Utilisateurs</h1>
            <a class="bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover" href="{{ path('admin_user_new') }}">Nouvel utilisateur</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mt-4 border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        <form method="get" class="mt-6 grid gap-3 md:grid-cols-6">
            <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher un utilisateur..." class="border border-dark px-3 py-2 text-sm md:col-span-2">
            <select name="role" class="border border-dark px-3 py-2 text-sm">
                <option value="all" {{ filter_role == 'all' ? 'selected' : '' }}>Tous les rôles</option>
                {% for role in available_roles %}
                    <option value="{{ role }}" {{ filter_role == role ? 'selected' : '' }}>{{ role|role_label }}</option>
                {% endfor %}
            </select>
            <select name="entreprise" class="border border-dark px-3 py-2 text-sm">
                <option value="0">Toutes les entreprises</option>
                {% for id, name in available_entreprises %}
                    <option value="{{ id }}" {{ filter_entreprise == id ? 'selected' : '' }}>{{ name }}</option>
                {% endfor %}
            </select>
            <div class="flex gap-2 md:col-span-2 justify-end">
                <button type="submit" class="cursor-pointer bg-brand-primary px-4 py-2 text-sm font-semibold text-white">Filtrer</button>

                <a href="{{ path('admin_user_index') }}" class="border border-dark px-4 py-2 text-sm font-semibold text-slate-700">Réinitialiser</a>
            </div>
            <input type="hidden" name="sort" value="{{ sort_field }}">
            <input type="hidden" name="dir" value="{{ sort_direction }}">
        </form>

        <div class="mt-6 overflow-x-auto overflow-hidden ring-1 ring-slate-200">
            <table class="w-full min-w-[720px] text-left text-sm">
                <thead class="bg-brand-card text-slate-600 h-[66px]">
                    <tr>
                        {% set nextEmailDir = sort_field == 'email' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        {% set nextRoleDir = sort_field == 'role' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        {% set nextEntrepriseDir = sort_field == 'entreprise' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_user_index', app.request.query.all|merge({ sort: 'email', dir: nextEmailDir })) }}">Email</a>
                        </th>
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_user_index', app.request.query.all|merge({ sort: 'role', dir: nextRoleDir })) }}">Rôle</a>
                        </th>
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_user_index', app.request.query.all|merge({ sort: 'entreprise', dir: nextEntrepriseDir })) }}">Entreprise</a>
                        </th>
                        <th class="px-4 py-3 font-semibold text-black text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for u in users %}
                        <tr class="hover:bg-neutral-50">
                            <td class="px-4 py-3 font-medium text-slate-900">{{ u.email }}</td>
                            <td class="px-4 py-3 text-slate-700">{{ u.primaryStoredRole|role_label }}</td>
                            <td class="px-4 py-3 text-slate-700">{{ u.entreprise.name }}{% if u.entreprise.agency %} <span class="text-slate-500">(agence)</span>{% endif %}</td>
                            <td class="px-4 py-3 text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a href="{{ path('admin_user_edit', { id: u.id }) }}" title="Modifier" class="text-brand hover:text-brand-primary-hover">
                                        <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/></svg>
                                    </a>
                                    {% if app.user and app.user.id != u.id %}
                                        <form class="inline-flex" method="post" action="{{ path('admin_user_delete', { id: u.id }) }}" onsubmit="return confirm('Supprimer cet utilisateur ?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ u.id) }}">
                                            <button type="submit" title="Supprimer" class="cursor-pointer text-red-700 hover:text-red-900">
                                                <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="px-4 py-6 text-slate-600">Aucun utilisateur.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        
    </div>
{% endblock %}

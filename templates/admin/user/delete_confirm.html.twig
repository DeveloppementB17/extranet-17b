{% extends 'base.html.twig' %}
{% import '_icon_macros.html.twig' as icons %}

{% block title %}Supprimer l’utilisateur{% endblock %}

{% block body %}
    <nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <a href="{{ path('admin_user_index') }}" class="hover:underline">Utilisateurs</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">Supprimer</span>
    </nav>

    <p class="mt-6 text-m">
        <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_user_index') }}">← Retour aux utilisateurs</a>
    </p>

    <div class="panel mx-auto mt-8 max-w-xl border-2 border-black px-8 py-8">
        <h1 class="text-3xl font-extrabold text-brand">Supprimer l’utilisateur</h1>
        <p class="mt-4 text-base text-slate-800">
            Vous allez supprimer le compte <strong>{{ user.email }}</strong>
            ({{ user.primaryStoredRole|role_label }}).
        </p>

        {% if requires_successor %}
            <div class="mt-6 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
                <p class="font-semibold">Références à reprendre</p>
                <ul class="mt-2 list-inside list-disc space-y-1">
                    {% if document_count > 0 %}
                        <li>{{ document_count }} document(s) lié(s) à ce compte{% if uploaded_document_count > 0 %} (dont {{ uploaded_document_count }} en tant qu’auteur de l’upload){% endif %}.</li>
                    {% endif %}
                    {% if time_credit_reference_count > 0 %}
                        <li>{{ time_credit_reference_count }} enregistrement(s) de crédits temps lié(s) à ce compte.</li>
                    {% endif %}
                </ul>
                <p class="mt-3">Choisissez un autre compte équipe 17b (admin ou utilisateur) qui reprendra ces références.</p>
            </div>
        {% else %}
            <p class="mt-4 text-sm text-slate-600">Aucun document ni crédit temps ne référence ce compte.</p>
        {% endif %}

        <form method="post" action="{{ path('admin_user_delete', { id: user.id }) }}" class="mt-8 space-y-6" onsubmit="return confirm('Confirmer la suppression définitive de {{ user.email|e('js') }} ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete_user' ~ user.id) }}">

            {% if requires_successor %}
                <div>
                    <label for="successor_id" class="mb-2 block text-sm font-semibold text-slate-800">Compte successeur</label>
                    <select id="successor_id" name="successor_id" required class="w-full border border-black px-3 py-2 text-sm">
                        <option value="">Sélectionnez un compte 17b…</option>
                        {% for successor in successors %}
                            <option value="{{ successor.id }}">{{ successor.email }} ({{ successor.primaryStoredRole|role_label }})</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}

            <div class="flex flex-wrap gap-3">
                <button type="submit" class="inline-flex cursor-pointer items-center gap-2 bg-red-700 px-4 py-2 text-sm font-semibold text-white hover:bg-red-800">
                    {{ icons.icon('trash') }}
                    Supprimer définitivement
                </button>
                <a href="{{ path('admin_user_index') }}" class="inline-flex items-center gap-2 border border-black px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-neutral-50">
                    {{ icons.icon('x') }}
                    Annuler
                </a>
            </div>
        </form>
    </div>
{% endblock %}

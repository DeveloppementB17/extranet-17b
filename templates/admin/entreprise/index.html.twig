{% extends 'base.html.twig' %}

{% block title %}Entreprises{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
    <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
    <span class="text-neutral-400"> / </span>
    <span class="font-medium" aria-current="page">Entreprises</span>
</nav>

<p class="mt-6 text-m">
            <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_dashboard') }}">← Retour à l’administration</a>
        </p>
    <div class="panel py-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
            <h1 class="text-5xl font-extrabold text-brand">Entreprises</h1>
            <a class="bg-brand-primary px-4 py-2 text-sm font-semibold text-white hover:bg-brand-primary-hover" href="{{ path('admin_entreprise_new') }}">Nouvelle entreprise</a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mt-4 border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
        {% endfor %}

        <form method="get" class="mt-6 grid gap-3 md:grid-cols-4">
            <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher une entreprise..." class="border border-dark px-3 py-2 text-sm md:col-span-2">
            <select name="type" class="border border-dark px-3 py-2 text-sm">
                <option value="all" {{ filter_type == 'all' ? 'selected' : '' }}>Tous les types</option>
                <option value="agency" {{ filter_type == 'agency' ? 'selected' : '' }}>Agence</option>
                <option value="client" {{ filter_type == 'client' ? 'selected' : '' }}>Cliente</option>
            </select>
            <div class="flex gap-2">
                <button type="submit" class="cursor-pointer bg-brand-primary px-4 py-2 text-sm font-semibold text-white">Filtrer</button>

                <a href="{{ path('admin_entreprise_index') }}" class="border border-dark px-4 py-2 text-sm font-semibold text-slate-700">Réinitialiser</a>
            </div>
            <input type="hidden" name="sort" value="{{ sort_field }}">
            <input type="hidden" name="dir" value="{{ sort_direction }}">
        </form>

        <div class="mt-6 overflow-hidden ring-1 ring-slate-200">
            <table class="w-full text-left text-sm">
                <thead class="bg-brand-card text-slate-600 h-[66px]">
                    <tr>
                        {% set nextNameDir = sort_field == 'name' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        {% set nextTypeDir = sort_field == 'type' and sort_direction == 'asc' ? 'desc' : 'asc' %}
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_entreprise_index', app.request.query.all|merge({ sort: 'name', dir: nextNameDir })) }}">Nom</a>
                        </th>
                        <th class="px-4 py-3 font-semibold">
                            <a class="inline-flex items-center gap-1 text-black hover:underline" href="{{ path('admin_entreprise_index', app.request.query.all|merge({ sort: 'type', dir: nextTypeDir })) }}">Type</a>
                        </th>
                        <th class="px-4 py-3 font-semibold text-black text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 bg-white">
                    {% for e in entreprises %}
                        <tr class="hover:bg-neutral-50">
                            <td class="px-4 py-3 font-medium text-slate-900">{{ e.name }}</td>
                            <td class="px-4 py-3 text-slate-700">{{ e.agency ? 'Agence' : 'Cliente' }}</td>
                            <td class="px-4 py-3 text-right">
                                <div class="inline-flex items-center gap-2">
                                    <a href="{{ path('admin_entreprise_edit', { id: e.id }) }}" title="Modifier" class="text-brand hover:text-brand-primary-hover">
                                        <svg class="w-5 h-5 hover:text-slate-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m14.304 4.844 2.852 2.852M7 7H4a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-4.5m2.409-9.91a2.017 2.017 0 0 1 0 2.853l-6.844 6.844L8 14l.713-3.565 6.844-6.844a2.015 2.015 0 0 1 2.852 0Z"/></svg>
                                    </a>
                                    <form class="inline-flex" method="post" action="{{ path('admin_entreprise_delete', { id: e.id }) }}" onsubmit="return confirm('Supprimer cette entreprise ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_entreprise' ~ e.id) }}">
                                        <button type="submit" title="Supprimer" class="cursor-pointer text-red-700 hover:text-red-900">
                                            <svg class="w-5 h-5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 7h14m-9 3v8m4-8v8M10 3h4a1 1 0 0 1 1 1v3H9V4a1 1 0 0 1 1-1ZM6 7h12v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7Z"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="3" class="px-4 py-6 text-slate-600">Aucune entreprise.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        
    </div>
{% endblock %}

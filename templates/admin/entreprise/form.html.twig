{% extends 'base.html.twig' %}

{% import 'admin/_form_macros.html.twig' as adminForm %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
        <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
        <span class="text-neutral-400"> / </span>
        <a href="{{ path('admin_entreprise_index') }}" class="hover:underline">Entreprises</a>
        <span class="text-neutral-400"> / </span>
        <span class="font-medium" aria-current="page">{{ title }}</span>
    </nav>

    <p class="mt-6 text-m">
        <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_entreprise_index') }}">← Retour aux entreprises</a>
    </p>

    <div class="mx-auto max-w-6xl ">
    <div class="panel border-2 border-black mx-auto max-w-lg px-8 py-8">
        <h1 class="text-3xl font-extrabold text-brand">{{ title }}</h1>

        {% set entreprise = form.vars.value %}

        {% for message in app.flashes('error') %}
            <div class="mt-4 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, { attr: { class: 'mt-8 space-y-8' } }) }}
            {{ adminForm.form_errors_all(form) }}
            <div class="relative z-0 w-full group">
                {{ form_widget(form.name, { attr: { class: 'block pt-2.5 pb-1 px-0 w-full text-lg text-heading bg-transparent border-0 border-slate-600 border-b border-default-medium appearance-none focus:outline-none focus:ring-0 peer', placeholder: ' ' } }) }}
                {{ form_label(form.name, null, { label_attr: { class: 'absolute text-lg font-semibold text-brand duration-300 transform -translate-y-6 scale-75 top-3 -z-10 origin-[0] peer-focus:start-0 peer-focus:bg-black peer-focus:text-white peer-focus:px-2 peer-focus:text-fg-brand peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-6 rtl:peer-focus:translate-x-1/4 rtl:peer-focus:left-auto' } }) }}
                {{ adminForm.field_errors(form.name) }}
            </div>
            {% if entreprise is defined and entreprise.id %}
                <p class="text-sm text-slate-600">
                    Identifiant technique : <code class="text-xs">{{ entreprise.slug }}</code>
                    <span class="text-slate-500">(généré à la création, non modifiable)</span>
                </p>
            {% else %}
                <p class="text-sm text-slate-600">L’identifiant technique (slug) sera généré automatiquement à partir du nom.</p>
            {% endif %}
            <div class="flex flex-wrap gap-3">
                <button type="submit" class="ml-auto block bg-brand-primary px-6 py-2 text-xl font-bold text-white hover:bg-brand-primary-hover button">Enregistrer</button>
                <a class="border border-slate-200 px-6 py-2 text-xl font-bold text-slate-700 hover:bg-slate-50" href="{{ path('admin_entreprise_index') }}">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
    </div>
{% endblock %}

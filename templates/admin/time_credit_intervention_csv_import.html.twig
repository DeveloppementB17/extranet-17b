{% extends 'base.html.twig' %}
{% import '_icon_macros.html.twig' as icons %}

{% block title %}Import CSV interventions{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
    <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
    <span class="text-neutral-400"> / </span>
    <a href="{{ path('admin_dashboard') }}" class="hover:underline">Administration</a>
    <span class="text-neutral-400"> / </span>
    <span class="font-medium" aria-current="page">Import CSV interventions</span>
</nav>

<p class="mt-6 text-m">
    <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_dashboard') }}">← Retour à l’administration</a>
</p>

<div class="panel py-8">
    <h1 class="text-5xl font-extrabold text-brand">Import CSV d’interventions</h1>
    <p class="mt-2 max-w-3xl text-m text-slate-600">
        Injectez en masse des interventions pour un client. Chaque ligne est rattachée au crédit temps via le
        <strong>numéro de dossier</strong>. Commencez par une simulation, puis décochez l’option pour enregistrer.
    </p>

    {% for message in app.flashes('success') %}
        <div class="mt-4 border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
    {% endfor %}

    <div class="mt-6 max-w-3xl border border-slate-200 bg-slate-50 px-4 py-4 text-sm text-slate-700">
        <p class="font-semibold text-slate-900">Format CSV attendu</p>
        <ul class="mt-2 list-disc space-y-1 pl-5">
            <li>Colonnes : <code>dossier</code>, <code>duree</code>, <code>date</code>, <code>descriptif</code></li>
            <li>Séparateur <code>;</code> ou <code>,</code> (Excel FR : point-virgule)</li>
            <li>Durée : minutes (<code>90</code>) ou heures (<code>1h30</code>, <code>2h</code>)</li>
            <li>Date : <code>JJ/MM/AAAA</code> ou <code>AAAA-MM-JJ</code></li>
        </ul>
        <p class="mt-3">
            <a class="font-semibold text-brand underline underline-offset-2" href="{{ path('admin_time_credit_intervention_csv_sample') }}">Télécharger un modèle CSV</a>
        </p>
    </div>

    {{ form_start(form, { attr: { class: 'mt-8 max-w-xl space-y-6', 'data-turbo': 'false' } }) }}
        <div>
            {{ form_label(form.entreprise, null, { label_attr: { class: 'block text-lg font-semibold text-brand mb-2' } }) }}
            {{ form_widget(form.entreprise, { attr: form.entreprise.vars.attr|merge({ class: 'block w-full rounded-base border border-default bg-white px-3 py-2.5 text-lg text-heading focus:outline-none focus:ring-2 focus:ring-brand-primary' }) }) }}
            {{ form_errors(form.entreprise) }}
        </div>
        <div>
            {{ form_label(form.file, null, { label_attr: { class: 'block text-lg font-semibold text-brand mb-2' } }) }}
            {{ form_widget(form.file, { attr: { class: 'block w-full text-sm text-slate-700' } }) }}
            {{ form_errors(form.file) }}
        </div>
        <div class="space-y-3">
            <label class="flex items-start gap-3 text-sm text-slate-800">
                {{ form_widget(form.dryRun, { attr: { class: 'mt-1 h-4 w-4 rounded border-slate-400 text-brand-primary focus:ring-brand-primary' } }) }}
                <span>{{ form.dryRun.vars.label }}</span>
            </label>
            <label class="flex items-start gap-3 text-sm text-slate-800">
                {{ form_widget(form.allowOverdraft, { attr: { class: 'mt-1 h-4 w-4 rounded border-slate-400 text-brand-primary focus:ring-brand-primary' } }) }}
                <span>{{ form.allowOverdraft.vars.label }}</span>
            </label>
        </div>
        <div class="flex flex-wrap gap-3">
            <button type="submit" class="inline-flex items-center gap-2 bg-brand-primary px-6 py-2 text-sm font-bold text-white hover:bg-brand-primary-hover">
                {{ icons.icon('upload') }}Lancer l’import
            </button>
            <a class="inline-flex items-center gap-2 border border-slate-200 px-6 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50" href="{{ path('admin_dashboard') }}">
                {{ icons.icon('x') }}Annuler
            </a>
        </div>
    {{ form_end(form) }}

    {% if result %}
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
            <div class="overflow-hidden ring-1 ring-slate-200">
                <div class="bg-slate-50 px-4 py-3 text-sm font-semibold text-slate-800">
                    Résultat — {{ result.imported }} OK · {{ result.skipped }} ignorée(s)
                </div>
                {% if result.successes is not empty %}
                    <ul class="max-h-80 divide-y divide-slate-100 overflow-y-auto bg-white text-sm text-slate-700">
                        {% for line in result.successes %}
                            <li class="px-4 py-2">{{ line }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="bg-white px-4 py-4 text-sm text-slate-500">Aucune ligne importée.</p>
                {% endif %}
            </div>
            <div class="overflow-hidden ring-1 ring-slate-200">
                <div class="bg-red-50 px-4 py-3 text-sm font-semibold text-red-800">
                    Erreurs ({{ result.errors|length }})
                </div>
                {% if result.errors is not empty %}
                    <ul class="max-h-80 divide-y divide-red-50 overflow-y-auto bg-white text-sm text-red-700">
                        {% for line in result.errors %}
                            <li class="px-4 py-2">{{ line }}</li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="bg-white px-4 py-4 text-sm text-slate-500">Aucune erreur.</p>
                {% endif %}
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

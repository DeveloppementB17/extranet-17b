{% extends 'base.html.twig' %}

{% block title %}Anciennes entreprises{% endblock %}

{% block body %}
<nav class="mb-4 font-['Proxima_Nova','Inter',sans-serif] text-base text-black" aria-label="Fil d'Ariane">
    <a href="{{ path('app_home') }}" class="hover:underline">Tableau de bord</a>
    <span class="text-neutral-400"> / </span>
    <a href="{{ path('admin_dashboard') }}" class="hover:underline">Administration</a>
    <span class="text-neutral-400"> / </span>
    <a href="{{ path('admin_legacy_data') }}" class="hover:underline">Anciennes données</a>
    <span class="text-neutral-400"> / </span>
    <span class="font-medium" aria-current="page">Entreprises</span>
</nav>

<p class="mt-6 text-m">
    <a class="block w-fit font-semibold text-brand underline underline-offset-2" href="{{ path('admin_legacy_data') }}">← Retour aux anciennes données</a>
</p>

<div class="panel py-8">
    <h1 class="text-5xl font-extrabold text-brand">Entreprises (ancien site)</h1>
    <p class="mt-2 max-w-3xl text-m text-slate-600">
        Importez une entreprise dans le nouveau site. Si le nom existe déjà, vous pouvez la lier (écrasement / association).
    </p>

    {% for message in app.flashes('success') %}
        <div class="mt-4 border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="mt-4 border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">{{ message }}</div>
    {% endfor %}

    <form method="get" class="mt-6 flex flex-wrap gap-2">
        <input type="text" name="q" value="{{ search_query }}" placeholder="Rechercher…" class="border border-black px-3 py-2 text-sm min-w-[240px]">
        <button type="submit" class="cursor-pointer bg-brand-primary px-4 py-2 text-sm font-semibold text-white">Filtrer</button>
        <a href="{{ path('admin_legacy_data_entreprises') }}" class="border border-black px-4 py-2 text-sm font-semibold text-slate-700">Réinitialiser</a>
    </form>

    <div class="mt-6 overflow-x-auto ring-1 ring-slate-200">
        <table class="w-full min-w-[800px] text-left text-sm">
            <thead class="bg-brand-card text-slate-600 h-[66px]">
                <tr>
                    <th class="px-4 py-3 font-semibold text-black">Nom</th>
                    <th class="px-4 py-3 font-semibold text-black">Source</th>
                    <th class="px-4 py-3 font-semibold text-black">État</th>
                    <th class="px-4 py-3 font-semibold text-black text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 bg-white">
                {% for row in rows %}
                    <tr class="hover:bg-neutral-50">
                        <td class="px-4 py-3 font-medium text-slate-900">
                            {{ row.name }}
                            {% if row.archived %}
                                <span class="ml-2 border border-slate-300 bg-slate-50 px-2 py-0.5 text-xs font-semibold text-slate-600">Archivée (ancien)</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-slate-600">#{{ row.legacySourceId }}</td>
                        <td class="px-4 py-3">
                            {% if row.status == 'imported' %}
                                <span class="border border-green-300 bg-green-50 px-2 py-0.5 text-xs font-semibold text-green-800">Déjà importée (#{{ row.matchedEntreprise.id }})</span>
                            {% elseif row.status == 'name_conflict' %}
                                <span class="border border-amber-300 bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-800">Nom déjà présent (#{{ row.matchedEntreprise.id }})</span>
                            {% else %}
                                <span class="border border-slate-300 bg-slate-50 px-2 py-0.5 text-xs font-semibold text-slate-700">Disponible</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-3 text-right">
                            {% if row.status == 'imported' %}
                                <a class="text-brand underline underline-offset-2" href="{{ path('admin_entreprise_edit', { id: row.matchedEntreprise.id }) }}">Voir</a>
                            {% elseif row.status == 'name_conflict' %}
                                <form method="post" action="{{ path('admin_legacy_data_entreprise_import', { legacySourceId: row.legacySourceId }|merge(search_query ? { q: search_query } : {})) }}" class="inline" onsubmit="return confirm('Lier l’entreprise existante « {{ row.matchedEntreprise.name|e('js') }} » à cette source ancienne ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('legacy_import_entreprise' ~ row.legacySourceId) }}">
                                    <input type="hidden" name="overwrite" value="1">
                                    {% if search_query %}<input type="hidden" name="q" value="{{ search_query }}">{% endif %}
                                    <button type="submit" class="cursor-pointer bg-amber-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-amber-800">Lier / écraser</button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('admin_legacy_data_entreprise_import', { legacySourceId: row.legacySourceId }|merge(search_query ? { q: search_query } : {})) }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('legacy_import_entreprise' ~ row.legacySourceId) }}">
                                    {% if search_query %}<input type="hidden" name="q" value="{{ search_query }}">{% endif %}
                                    <button type="submit" class="cursor-pointer bg-brand-primary px-3 py-1.5 text-sm font-semibold text-white hover:bg-brand-primary-hover">Importer</button>
                                </form>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-4 py-6 text-slate-600">Aucune entreprise.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
